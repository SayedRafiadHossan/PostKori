# Copy this file to .env.local and fill in the values
# Get a free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: models to try in order, comma-separated (backup used if one is busy)
# Default: gemini-flash-lite-latest,gemini-flash-latest,gemini-2.5-flash
# GEMINI_MODEL=

# Your live site URL (used for the social share image), e.g. https://postkori.vercel.app
# NEXT_PUBLIC_SITE_URL=

# Optional: posts allowed per visitor per hour in production (default: 10)
# RATE_LIMIT_PER_HOUR=10
